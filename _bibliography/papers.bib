  abstract = {A designed two-compartment cell was applied to the degradation analysis of {FeF}3 having high theoretical energy density. Comparing with the result of the coin cell, the two-compartment cell gave us insight that the elution of Fe was responsible for the degradation of {FeF}3 and {LiDFOB} was found as an essentially effective additive for suppressing the degradation of {FeF}3.}, 
  pages    = {4878--4881}, 
