@article{yokoyama2019situ-e9b, 
  year     = {2019}, 
  title    = {In Situ Measurement of Local {pH} at Working Electrodes in Neutral {pH} Solutions by the Rotating Ring‐Disk Electrode Technique}, 
  author   = {Yokoyama, Yuko and Miyazaki, Kohei and Miyahara, Yuto and Fukutsuka, Tomokazu and Abe, Takeshi}, 
  journal  = {{ChemElectroChem}}, 
  issn     = {2196-0216}, 
  doi      = {10.1002/celc.201900759}, 
  abstract = {When electrochemical reactions that generate/consume protons or hydroxide ions take place, the local {pH} in the vicinity of an electrode becomes considerably different from the bulk {pH}. However, measuring the local {pH} is very difficult, and the idea of using a rotating ring‐disk electrode ({RRDE}) is not applicable to solutions with neutral {pH}. Herein, we extend the theory of local {pH} measurement using a {RRDE} and make it applicable to solutions with a wide {pH} range. This extended theory is corroborated by measurements of hydrogen oxidation/evolution reactions in solutions with near‐neutral {pH}. In addition, the local {pH} change in a highly concentrated solution is also measured, and the results show that this local {pH} measurement method can be used regardless of the solution concentration. Any {pH} solution can be measured: Extended theory of local {pH} measurement using a rotating ring‐disk electrode is shown. The theory is applicable to solutions with a wide {pH} range and corroborated by measurements in solutions with near‐neutral {pH}. In addition, the local {pH} change in a highly concentrated solution is also measured, and the results show that this method can be used regardless of the solution concentration.}, 
  pages    = {4750--4756}, 
  number   = {18}, 
  volume   = {6}
}
@article{dongmo2019implications-1cf, 
  year     = {2019}, 
  title    = {Implications of Testing a Zinc–Oxygen Battery with Zinc Foil Anode Revealed by Operando Gas Analysis}, 
  author   = {Dongmo, Saustin and Stock, Daniel and Kreissl, Julian Jakob Alexander and Groß, Martin and Weixler, Sophie and Hagen, Markus and Miyazaki, Kohei and Abe, Takeshi and Schröder, Daniel}, 
  journal  = {{ACS} Omega}, 
  issn     = {2470-1343}, 
  doi      = {10.1021/acsomega.9b03224}, 
  pmid     = {31956811}, 
  abstract = {Zinc-oxygen batteries are seen as promising energy storage devices for future mobile and stationary applications. Introducing them as secondary battery is hindered by issues at both the anode and cathode. Research efforts were intensified during the past two decades, mainly focusing on catalyst materials for the cathode. Thereby, zinc foil was almost exclusively used as the anode in electrochemical testing in the lab-scale as it is easy to apply and shall yield reproducible results. However, it is well known that zinc metal reacts with water within the electrolyte to form hydrogen. It is not yet clear how the evolution of hydrogen is affecting the performance results obtained thereof. Herein, we extend the studies and the understanding about the evolution of hydrogen at zinc by analyzing the zinc-oxygen battery during operation. By means of electrochemical measurements, operando gas analysis, and anode surface analysis, we elucidate that the rate of the evolution of hydrogen scales with the current density applied, and that the roughness of the anode surface, that is, the pristine state of the zinc foil surface, affects the rate as well. In the end, we propose a link between the evolution of hydrogen and the unwanted impact on the actual electrochemical performance that might go unnoticed during testing. Thereof, we elucidate the consequences that arise for the working principle and the testing of materials for this battery type.}, 
  pages    = {626--633}, 
  number   = {1}, 
  volume   = {5}
}
@article{maruyama2019nanoscopic-6d8, 
  year     = {2019}, 
  title    = {Nanoscopic Combination of Edge and Flat Planes in the Active Site for Oxygen Reduction and Evolution}, 
  author   = {Maruyama, Jun and Maruyama, Shohei and Fukuhara, Tomoko and Takao, Yuko and Miyazaki, Kohei}, 
  journal  = {European Journal of Inorganic Chemistry}, 
  issn     = {1434-1948}, 
  doi      = {10.1002/ejic.201900761}, 
  abstract = {An iron‐containing carbonaceous flat plane was enriched with edges by substrate fine etching and metal oxide loading, resulting in substantial enhancement of the catalytic activity for the oxygen reduction and evolution, which was fundamentally shown using the highly oriented pyrolytic graphite basal plane as the substrate. The evolution close to the standard electrode potential was elucidated by a mechanism involving the nanoscopic edge‐flat plane combination. Combination of edge‐oriented Fe–N2 and planar Fe–N4 units functioned as 3‐D active sites. Loaded {MnOOH} also provided the edge. The O2 evolution proceeded with a substantially low overpotential by the edge‐plane combination. The O2 reduction was also enhanced by the edge enrichment to confirm the promising bifunctional catalysis.}, 
  pages    = {4117--4121}, 
  number   = {38}, 
  volume   = {2019}
}
@article{kondo2019sodiumion-437, 
  year     = {2019}, 
  title    = {Sodium-ion Intercalation Behavior of Graphitized Carbon Nanospheres Covered with Basal Plane}, 
  author   = {Kondo, Yasuyuki and Fukutsuka, Tomokazu and Miyazaki, Kohei and Miyahara, Yuto and Abe, Takeshi}, 
  journal  = {Chemistry Letters}, 
  issn     = {0366-7022}, 
  doi      = {10.1246/cl.190111}, 
  abstract = {Sodium-ion intercalation into the bulk of graphite hardly occurs. In this study, a nano-sized graphitizable carbon nanospheres ({CNS}) covered with basal planes were used to shorten the diffusion length, minimize side reaction and evaluate the dependence of graphitization degree. As a result, electrolyte decomposition was minimized by basal planes covering the surface and sodium-ion more clearly intercalating into {CNSs} than into ordinal graphite. It was also clarified that sodium-ion inserted into the bulk of {CNSs} as the graphitization degree decreased. Sodium-ion intercalation into the bulk of graphite hardly occurs. In this study, a nano-sized graphitizable carbon nanospheres ({CNS}) covered with basal planes were used to shorten the diffusion length and minimize side reaction. Electrolyte decomposition was minimized by basal planes covering surface and sodium-ion clearly intercalated into {CNSs}. Sodium-ion inserted into the bulk of {CNSs} as graphitization degree decreased.}, 
  pages    = {799--801}, 
  number   = {8}, 
  volume   = {48}
}
