  author   = {Miyazaki, Kohei and Fukutsuka, Tomokazu and Abe, Takeshi and Ogumi, Zempachi}, 
  journal  = {Chemistry Letters}, 
  issn     = {0366-7022}, 
  doi      = {10.1246/cl.130072}, 
  abstract = {Step-edge-decorated graphite electrodes with Pt nanoparticles were fabricated by pulsed laser deposition ({PLD}), and the impacts of the morphological change of Pt nanoparticles on the electrocatalytic activities were investigated. Primary Pt particles (about 5 nm in diameter) were formed by {PLD} and were aggregated along the step-edge lines of highly oriented pyrolytic graphites ({HOPGs}). An increase in the temperature of the {HOPG} substrate leaded to the diffusion of Pt particles along the step-edge lines of {HOPG} and resulted in the agglomeration of Pt particles (100–150 nm in diameter). As for methanol oxidation, it is found that the agglomerated Pt particles exhibited higher catalytic activities than small Pt nanoparticles on {HOPGs}.}, 
  pages    = {606--608}, 
  number   = {6}, 
  volume   = {42}
}
