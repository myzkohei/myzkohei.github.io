@article{lee2021cathodeelectrolyteinterphase-c9d, 
  year     = {2021}, 
  title    = {Cathode‐Electrolyte‐Interphase Film Formation on a {LiNiO}2 Surface in Conventional Aqueous Electrolytes: Simple Method to Improve the Electrochemical Performance of {LiNiO}2 Electrodes for Use in Aqueous Li‐Ion Batteries}, 
  author   = {Lee, Changhee and Yokoyama, Yuko and Kondo, Yasuyuki and Miyahara, Yuto and Abe, Takeshi and Miyazaki, Kohei}, 
  journal  = {Advanced Energy Materials}, 
  issn     = {1614-6832}, 
  doi      = {10.1002/aenm.202100756}, 
  abstract = {Passivation films, the so‐called solid–electrolyte interphase and cathode–electrolyte interphase ({CEI}), are considered to be essential for the operation of rechargeable batteries because they have a positive impact on electrochemical performance including cyclability. In the field of aqueous Li‐ion batteries ({ALIBs}) to date, it is generally accepted that these films can only be formed in super‐concentrated electrolytes containing fluorine‐based organic anions such as N({SO}2CF3)2 and {SO}3CF3. This study demonstrates for the first time that a {CEI} film can be created on a {LiNiO}2 ({LNO}) electrode in conventional aqueous electrolytes and improve electrochemical performance such as reversible capacities and cyclability. The results reveal that a {CEI} film, mainly composed of Li2CO3 and {LiOH}, is formed on the {LNO} surface in a saturated {LiNO}3 aqueous electrolyte containing {LiOH} beginning at the first de‐intercalation of Li+ ions, suppressing side reactions between the surface and aqueous electrolyte, and improving the recovery rate of structural changes of {LNO} during the charge/discharge process. As a result, this study suggests that {LNO} has great potential for application as a cathode material for high energy density {ALIBs}. This study reports that cathode–electrolyte interphase film can be created on a {LiNiO}2 ({LNO}) surface in conventional aqueous electrolytes, improving electrochemical performance including cyclability, and charge/discharge capacities, for the first time. The improved values of the performances lead to the expectation that {LNO} can be realized as a cathode material for high energy density aqueous Li‐ion batteries.}, 
  pages    = {2100756}, 
  number   = {25}, 
  volume   = {11}
}
